{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "{{appName}}",
    "labels": { "app": "{{appName}}" },
    "namespace": "{{namespace}}"
  },
  "spec": {
    "replicas": {{replicaCount}},
    "selector": { "matchLabels": { "app": "{{appName}}" } },
    "template": {
      "metadata": { "labels": { "app": "{{appName}}" }, "namespace": "{{namespace}}"  },
      "spec": {
        "containers": [
          {
            "name": "{{appName}}",
            "image": "{{image}}:{{tag}}",
            "ports": [
              {{#each ports}}
              { "containerPort": {{this}} }{{#unless @last}},{{/unless}}
              {{/each}}
            ],
            "env": [
              {{#each envVars}}
              { "name": "{{this.name}}", "value": "{{this.value}}" }{{#unless @last}},{{/unless}}
              {{/each}}
            ]
          }
        ]
      }
    }
  }
}
