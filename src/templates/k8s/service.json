{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": { "name": "{{appName}}" },
  "spec": {
    "selector": { "app": "{{appName}}" },
    "ports": [
      {{#each ports}}
      { "port": {{this.port}}, "targetPort": {{this.targetPort}}, "protocol": "{{this.protocol}}" }{{#unless @last}},{{/unless}}
      {{/each}}
    ],
    "type": "{{serviceType}}"
  }
}
